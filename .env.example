# Copy to .env.local and fill in. .env.local is gitignored.

# Instagram scraping via RapidAPI (instagram-scraper-stable-api).
# OPTIONAL: if this is missing or the call fails, rate-limits, or times out,
# processInstagramVibe silently falls back to the hardcoded Tokyo mock post.
RAPIDAPI_KEY=

# Gemini, used by BOTH flows -- photo analysis and the chat director.
# REQUIRED: without it every model call fails. The Instagram flow will still
# render the mock photo, and the chat director will still serve its fallback
# card, but nothing will actually be generated.
GOOGLE_GENERATIVE_AI_API_KEY=

# Unsplash Search API, used for destination-level pictures (board fillers
# and the wallpaper). Named venues go through Places instead.
# OPTIONAL: without it, destination lookups fall through to Wikimedia Commons.
# Access Key only (Authorization: Client-ID). The app's Secret Key is for
# OAuth flows this project does not use, so it does not belong here.
# Demo apps are capped at 50 requests/hour; a board costs 3.
UNSPLASH_ACCESS_KEY=

# Google Places API (New). Used to find a real photo of a named venue
# (Text Search + Place Photos). The key stays on the server; the browser
# never sees it. OPTIONAL: without it, named stops render as written cards.
GOOGLE_PLACES_API_KEY=
